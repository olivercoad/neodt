    },
    "./react/date-fns": {
      "types": "./dist/react/date-fns.d.ts",
      "default": "./dist/react/date-fns.js"
    },
    "./react/spacetime": {
      "types": "./dist/react/spacetime.d.ts",
      "default": "./dist/react/spacetime.js"
    },
    "./react/internationalized-date": {
      "types": "./dist/react/internationalized-date.d.ts",
      "default": "./dist/react/internationalized-date.js"
    },
    "./vue": {
