{
  "name": "@olicoad/neodt",
  "version": "0.1.6",
  "private": false,
  "description": "A configurable, locale-aware datetime-local input for Solid.",
  "keywords": [
    "date",
    "date-time-picker",
    "datetime",
    "datetime-local",
    "solid",
    "solidjs",
    "time"
  ],
  "homepage": "https://neodt.olisworld.com",
  "bugs": {
    "url": "https://github.com/olivercoad/neodt/issues"
  },
  "license": "MIT",
  "author": "olicoad",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olivercoad/neodt.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.jsx",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite serve dev",
    "dev:build": "vite build dev --config dev/vite.config.ts",
    "dev:typecheck": "tsc --noEmit -p dev/tsconfig.json",
    "build": "tsdown",
    "test": "concurrently pnpm:test:*",
    "test:client": "TZ=Australia/Melbourne LANG=C.UTF-8 LC_ALL=C.UTF-8 vitest",
    "test:ssr": "pnpm run test:client --mode ssr",
    "prepack": "pnpm build",
    "format": "oxfmt --write .",
    "lint": "concurrently pnpm:lint:*",
    "lint:code": "oxlint --deny-warnings",
    "lint:types": "tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm dev:typecheck && pnpm dev:build",
    "update-deps": "pnpm up -Li"
  },
  "dependencies": {
    "@solid-primitives/resize-observer": "^2.2.0",
    "@solid-primitives/storage": "^4.4.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@tsdown/css": "^0.22.14",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "concurrently": "^8.2.2",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "solid-js": "^1.8.17",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
