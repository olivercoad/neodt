    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm generate && vite serve dev",
    "dev:build": "pnpm generate && vite build dev --config dev/vite.config.ts",
    "dev:typecheck": "tsc --noEmit -p dev/tsconfig.json",
    "build": "pnpm generate && node scripts/clean-build.ts && tsdown && node scripts/package-exports.ts",
    "test": "concurrently pnpm:test:client pnpm:test:ssr",
    "test:client": "pnpm generate && TZ=Australia/Melbourne LANG=C.UTF-8 LC_ALL=C.UTF-8 vitest",
    "test:ssr": "pnpm run test:client --mode ssr",
    "prepack": "pnpm build",
    "format": "oxfmt --write .",
    "lint": "concurrently pnpm:lint:*",
    "lint:code": "oxlint --deny-warnings",
    "lint:types": "node scripts/typecheck.ts",
    "check": "pnpm generate && pnpm format:check && pnpm lint && pnpm test && pnpm dev:typecheck && pnpm dev:build && pnpm test:package",
    "update-deps": "pnpm up -Li",
    "test:browser": "playwright test",
    "format:check": "oxfmt --check .",
    "check:release": "pnpm check && pnpm test:browser && pnpm build",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "generate": "node scripts/generate.ts"
  },
  "devDependencies": {
    "@builder.io/mitosis": "0.14.0",
    "@date-fns/tz": "^1.5.0",
