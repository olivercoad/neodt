    },
    "./react/generic": {
      "types": "./dist/react/generic.d.ts",
      "default": "./dist/react/generic.js"
    },
    "./react/temporal-polyfill": {
      "types": "./dist/react/temporal-polyfill.d.ts",
      "default": "./dist/react/temporal-polyfill.js"
    },
    "./react/js-temporal-polyfill": {
      "types": "./dist/react/js-temporal-polyfill.d.ts",
      "default": "./dist/react/js-temporal-polyfill.js"
    },
    "./react/luxon": {
      "types": "./dist/react/luxon.d.ts",
