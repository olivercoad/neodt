{
  "name": "neodt",
  "version": "0.0.0",
  "private": false,
  "description": "A configurable, locale-aware datetime-local input for Solid.",
  "keywords": [
    "solid"
  ],
  "homepage": "https://github.com/{{me}}/{{name_of_lib}}#readme",
  "bugs": {
    "url": "https://github.com/{{me}}/{{name_of_lib}}/issues"
  },
  "license": "MIT",
  "author": "{{me}}",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{me}}/{{name_of_lib}}.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": {},
  "types": "./dist/index.d.ts",
  "typesVersions": {},
  "exports": {
    "solid": {
      "development": "./dist/dev.jsx",
      "import": "./dist/index.jsx"
    },
    "development": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dev.js"
      }
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite serve dev",
    "dev:build": "vite build dev --config dev/vite.config.ts",
    "dev:typecheck": "tsc --noEmit -p dev/tsconfig.json",
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "concurrently pnpm:test:*",
    "test:client": "vitest",
    "test:ssr": "pnpm run test:client --mode ssr",
    "prepublishOnly": "pnpm build",
    "format": "oxfmt --write .",
    "lint": "concurrently pnpm:lint:*",
    "lint:code": "oxlint --deny-warnings",
    "lint:types": "tsc --noEmit",
    "check": "pnpm lint && pnpm test && pnpm dev:typecheck && pnpm dev:build",
    "update-deps": "pnpm up -Li"
  },
  "dependencies": {
    "@solid-primitives/resize-observer": "^2.2.0",
    "@solid-primitives/storage": "^4.4.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "concurrently": "^8.2.2",
    "jsdom": "^24.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "solid-js": "^1.8.17",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.1"
}
