    },
    "./solid/luxon": {
      "types": "./dist/solid/luxon.d.ts",
      "default": "./dist/solid/luxon.jsx"
    },
    "./solid/moment": {
      "types": "./dist/solid/moment.d.ts",
      "default": "./dist/solid/moment.jsx"
    },
    "./solid/dayjs": {
      "types": "./dist/solid/dayjs.d.ts",
      "default": "./dist/solid/dayjs.jsx"
    },
    "./solid/date-fns": {
      "types": "./dist/solid/date-fns.d.ts",
      "default": "./dist/solid/date-fns.jsx"
    },
    "./solid/spacetime": {
