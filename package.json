{
  "name": "@olicoad/neodt",
  "version": "0.3.1",
  "private": false,
  "description": "A framework- and datetime-library-independent, locale-aware datetime input.",
  "keywords": [
    "date",
    "date-time-picker",
    "datetime",
    "datetime-local",
    "mitosis",
    "react",
    "solid",
    "solidjs",
    "time",
    "vue"
  ],
  "homepage": "https://neodt.olisworld.com",
  "bugs": {
    "url": "https://github.com/olivercoad/neodt/issues"
  },
  "license": "MIT",
  "author": "olicoad",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olivercoad/neodt.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
