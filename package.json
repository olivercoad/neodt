      "types": "./dist/vue/moment.d.ts",
      "default": "./dist/vue/moment.js"
    },
    "./vue/dayjs": {
      "types": "./dist/vue/dayjs.d.ts",
      "default": "./dist/vue/dayjs.js"
    },
    "./vue/date-fns": {
      "types": "./dist/vue/date-fns.d.ts",
      "default": "./dist/vue/date-fns.js"
    },
    "./vue/spacetime": {
