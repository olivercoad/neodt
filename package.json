    "dayjs": "^1.11.23",
    "jsdom": "^30.0.1",
    "luxon": "^3.7.2",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.4",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "solid-js": "^1.8.17",
    "spacetime": "^7.15.0",
    "temporal-polyfill": "^1.0.5",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  },
  "peerDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@internationalized/date": "^3.12.4",
    "@js-temporal/polyfill": "^0.5.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "luxon": "^3.7.2",
    "moment": "^2.31.0",
    "react": "^18.0.0 || ^19.0.0",
